# Database (Neon or any Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Public address of the site, no trailing slash
APP_URL="https://tradertrades.com"

# Long random string used to sign and encrypt things. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=""

# Comma separated emails that become admins once the email is confirmed
ADMIN_EMAILS=""

# Email sending (optional). Without it, emails are saved to the outbox at /admin/emails
RESEND_API_KEY=""
EMAIL_FROM="TraderTrades <hello@tradertrades.com>"

# Payments (optional). Without them, checkout runs in test mode with no real money
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# File storage on Vercel (optional). Without it, files are saved to .data/uploads
BLOB_READ_WRITE_TOKEN=""

# Video calls (optional). Without it, calls use a free Jitsi room
DAILY_API_KEY=""

# Extra content checks with Claude (optional)
ANTHROPIC_API_KEY=""

# Shown on the help page.
SUPPORT_EMAIL="support@tradertrades.com"

# 1 = preview helpers on (test checkout without Stripe, email links shown on screen). Turn OFF before real launch.
DEMO_MODE="1"
